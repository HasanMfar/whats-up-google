# Copy this file to .env and fill in your own values.
# Never commit the real .env - it is ignored by git.

# Archil API key. Create one at https://console.archil.com/
ARCHIL_API_KEY=key-...

# Region where your compute runs. Serverless exec supports:
# aws-us-east-1, aws-us-west-2, aws-eu-west-1
ARCHIL_REGION=aws-us-east-1
